{
  "name": "github-action-benchmark",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint '**/*.{ts,js}'",
    "fix": "eslint --fix '**/*.{ts,js}'",
    "format": "prettier -w **",
    "format:check": "prettier -c **",
