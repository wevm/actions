  "bugs": {
    "url": "https://github.com/benchmark-action/github-action-benchmark/issues"
  },
  "homepage": "https://github.com/benchmark-action/github-action-benchmark#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^5.1.1",
    "@actions/io": "^1.1.2",
    "zod": "^4.1.5"
  }
